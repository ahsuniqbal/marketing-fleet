    {
      "order": 1,
      "clip": "raw/<file>.mp4",
      "in": "00:00:12.400",
      "out": "00:00:15.100",
      "purpose": "hook",
      "log_ref": "footage-log.md#<clip-id>",
      "transcript": "<exact words spoken in this range>",
      "overlay": { "type": "text", "text": "<on-screen text>", "component": "LowerThird" },
      "reframe": "track-subject"
    }
  ],
  "brand": { "intro": "BrandIntro", "outro": "BrandOutro", "captions": "Captions" },
  "changelog": []
}
