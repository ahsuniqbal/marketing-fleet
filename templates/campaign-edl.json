{
  "deliverable_id": "<NN>-<format>-<seq>",
  "source_script": "copy/scripts/<deliverable-id>.md",
  "fps": 30,
  "target_duration_s": 30,
  "ratios": ["9:16", "1:1", "16:9"],
  "audio": {
    "music": { "file": "video/assets/<track>.mp3", "license": "see video/assets.md", "gain_db": -18 },
    "loudness_lufs": -14
  },
