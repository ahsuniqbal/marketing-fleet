# marketing-fleet — API keys
#
# Copy this file to the ROOT OF YOUR AGENCY WORKSPACE as `.env` (not into the plugin):
#   cp .env.example /path/to/your-workspace/.env
# Fill in the keys you have. All are optional: a stage that needs a missing key stops and asks.
# `.env` is gitignored by templates/workspace.gitignore — never commit real keys.
#
# Claude Code does not read .env by itself. Load it into the shell before starting Claude:
#   set -a; source .env; set +a; claude
# (or use direnv with `dotenv` in an .envrc).

# Social data — Instagram, Facebook, TikTok public posts (social-research, F.1b)
# https://apify.com — free account, monthly free credit
APIFY_TOKEN=

# Final voiceover on locked scripts (produce-video, C.4c)
# https://elevenlabs.io — free tier ~10k characters/month
ELEVENLABS_API_KEY=

# Free stock images, footage and music (produce-creatives, produce-video)
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Google Analytics 4, read-only (tracking-check C.7, campaign-report C.9)
# Absolute path to a Google Cloud service-account JSON key that has Viewer access on the GA4 property
GOOGLE_APPLICATION_CREDENTIALS=
# The Google Cloud project ID that service account belongs to
GOOGLE_PROJECT_ID=
